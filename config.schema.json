{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "properties": {
        "urls": {
            "type": "object",
            "properties": {
                "defaultRedirect": {
                    "type": "string",
                    "description": "The URL to redirect to by default after authentication, of form https://janishutz.com"
                },
                "frontendURL": {
                    "type": "string",
                    "description": "The URL of the frontend. This is used to control CORS"
                },
                "backendURL": {
                    "type": "string",
                    "description": "The URL of the backend. Just the host, of form https://janishutz.com"
                },
                "trustedProxies": {
                    "type": "array",
                    "description": "A list of IPs or address ranges in CIDR notation for trusted proxies",
                    "items": {
                        "type": "string",
                        "pattern": "^([0-9]{1,3}\\.){3}([0-9]){1,3}(\\/(([1-2])?[0-9])|\\/3[01])?$"
                    }
                }
            },
            "additionalProperties": false,
            "required": [
                "defaultRedirect",
                "frontendURL",
                "backendURL"
            ]
        },
        "dataDir": {
            "type": "string",
            "default": "./data",
            "description": "The directory in which to store uploads, sqlite db, etc"
        }
    },
    "required": [
        "urls",
        "dataDir"
    ]
}
